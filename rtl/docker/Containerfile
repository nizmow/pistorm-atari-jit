FROM ubuntu:20.04

ARG DEBIAN_FRONTEND=noninteractive
ARG ACCEPT_INTEL_EULA=0

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    ca-certificates \
    libfontconfig1 \
    libfreetype6 \
    libglib2.0-0 \
    libice6 \
    libncurses5 \
    libsm6 \
    libtinfo5 \
    libudev1 \
    libx11-6 \
    libxext6 \
    libxft2 \
    libxrender1 \
    libxtst6 \
    libxau6 \
    libxdmcp6 \
    locales \
    perl \
    python3 \
    zlib1g \
    && rm -rf /var/lib/apt/lists/*

RUN sed -i '/^# en_US.UTF-8 UTF-8/s/^# //' /etc/locale.gen \
    && locale-gen

COPY QuartusLiteSetup-20.1.1.720-linux.run max-20.1.1.720.qdz /tmp/quartus/
COPY verify-devices.tcl /tmp/verify-devices.tcl

RUN test "$ACCEPT_INTEL_EULA" = 1 \
    && chmod +x /tmp/quartus/QuartusLiteSetup-20.1.1.720-linux.run \
    && /tmp/quartus/QuartusLiteSetup-20.1.1.720-linux.run \
        --mode unattended \
        --unattendedmodeui none \
        --installdir /opt/intelFPGA_lite/20.1 \
        --accept_eula 1 \
    && /opt/intelFPGA_lite/20.1/quartus/bin/quartus_sh \
        -t /tmp/verify-devices.tcl \
    && rm -rf /tmp/quartus

ENV PATH="/opt/intelFPGA_lite/20.1/quartus/bin:${PATH}"
# Load libudev before Quartus's allocator to avoid the libsys_cpt deep-bind
# allocator mismatch (realloc(): invalid pointer) in WSL/container builds.
ENV LD_PRELOAD="/lib/x86_64-linux-gnu/libudev.so.1"
WORKDIR /work
CMD ["quartus_sh", "--version"]
